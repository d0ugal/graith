{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices'],
  automerge: true,
  gitIgnoredAuthors: ['github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>'],
  packageRules: [
    { matchManagers: ['gomod'], enabled: true },
    { matchManagers: ['gomod'], postUpdateOptions: ['gomodTidy'] },
    { matchManagers: ['gomod'], commitMessagePrefix: 'fix:', commitMessageAction: 'update' },
    {
      // go-libghostty is only safe to update through the native lock manager
      // below. A gomod-only branch would omit the matching Ghostty archive,
      // headers, checksums, licenses, SPDX inventory, and native validation.
      matchManagers: ['gomod'],
      matchPackageNames: ['go.mitchellh.com/libghostty'],
      enabled: false,
      automerge: false,
    },
    {
      // Safehouse version bumps must be paired with a reviewed release-asset
      // digest in sandbox.yml. Keep those PRs visible and manual so the global
      // automerge default cannot merge a new sandbox executable without review.
      matchDepTypes: ['ci-safehouse'],
      automerge: false,
      dependencyDashboardApproval: true,
      prBodyNotes: [
        'Safehouse CI installs are checksum-verified. Review the upstream release notes, update SAFEHOUSE_SHA256 from the reviewed safehouse.sh asset digest, and run the macOS sandbox enforcement job before merge.',
      ],
    },
    {
      matchDepTypes: ['libghostty-native'],
      groupName: 'libghostty native dependency unit',
      groupSlug: 'libghostty-native',
      automerge: false,
      rangeStrategy: 'replace',
      commitMessagePrefix: 'fix:',
      commitMessageAction: 'update',
      commitMessageTopic: 'native libghostty dependency unit',
      prBodyNotes: [
        'This group is an exact native dependency unit and must never be automerged.',
        'For same-repository lock-only PRs, a maintainer should review the proposal, including go-libghostty\'s tested Ghostty pin, and apply native-artifact-approved. The trusted artifact workflow consumes that exact label event, builds/publishes Apple and Linux assets keyed by the Ghostty, go-libghostty, and Zig inputs, then pushes the generated go.mod/go.sum, Ghostty and wrapper revisions, Zig/transitive source and license hashes, committed headers, SPDX, and notices back to this branch. Reapply the label after a rebase or synchronize event.',
        'If license or embedded-notice hashes changed, inspect the exact evidence and run scripts/libghostty-native.sh accept-license-reviews before regenerating. Run every required libghostty native check before merge. See the contributing guide for commit-pinned and vendored discovery rules.',
      ],
    },
    {
      // The wrapper's CMakeLists.txt is the compatibility authority for the
      // normal unit update, and wrapper moves can select a new Ghostty commit
      // that first needs a reviewed Apple artifact. Keep every native graph
      // proposal visible on the dependency dashboard, but require explicit
      // approval before Renovate opens the dependency-unit PR.
      matchDepTypes: ['libghostty-native'],
      matchDepNames: ['go-libghostty', 'Ghostty', 'Zig', 'uucode', 'Highway', 'simdutf'],
      dependencyDashboardApproval: true,
    },
    {
      // Defer the unsupported Ghostty d4ac93a -> 15484b6 and Highway
      // 1.2.0 -> 1.4.0 proposal. The matching libghostty-vt-15484b6 Apple
      // artifact is not buildable through the reviewed artifact workflow, so
      // generation cannot produce a reviewable dependency unit. Remove this
      // rule only after the artifact workflow can publish Apple and Linux
      // releases whose notes and GitHub asset digests bind that full commit.
      matchDepTypes: ['libghostty-native'],
      matchJsonata: [
        "(depName = 'Ghostty' and currentDigest = 'd4ac93a0395d321b043ee0116dc8a1a384f0fb83') or (depName = 'Highway' and currentValue = '1.2.0')",
      ],
      enabled: false,
    },
    {
      // gvisor.dev/gvisor is a transitive dependency of tailscale.com, which
      // pins the exact revision it needs. gvisor's repo is Bazel-structured, so
      // arbitrary upstream commits don't compile with `go build` (e.g. a stray
      // `package bridge` test file in pkg/tcpip/stack). Let the pin track
      // tailscale rather than the latest digest. See closed PR #875.
      matchPackageNames: ['gvisor.dev/gvisor'],
      enabled: false,
    },
    {
      // These modules are transitive dependencies whose versions are pinned by
      // their parents — go-proxyproto, rtnetlink and wireguard-go by
      // tailscale.com, and libc by modernc.org/sqlite. graith does not import
      // any of them directly (`go mod why` traces every one through
      // tailscale.com or modernc.org/sqlite). Bumping them independently
      // overrides the exact version the parent was tested against, and the only
      // updates on offer are breaking majors/digests that risk breaking the
      // parent's own compilation: go-proxyproto v0.15 changes the PROXY-protocol
      // spec (2.3→3.4), rtnetlink v2 changes the LinkDriver API, and libc v2 is
      // a new module path. Let these pins track the parent instead, mirroring
      // the gvisor.dev/gvisor rule above. See closed PRs #960 (go-proxyproto),
      // #932 (rtnetlink), #659 (libc) and dependency dashboard #90.
      matchPackageNames: [
        'github.com/pires/go-proxyproto',
        'github.com/jsimonetti/rtnetlink',
        'github.com/tailscale/wireguard-go',
        'modernc.org/libc',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      // CI workflows consume these pins from one checked-in env file. Keep
      // version-only tools here so workflow-local env blocks do not drift.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\\/ci-tool-versions\\.env$/'],
      matchStrings: ['HUGO_VERSION=(?<currentValue>[\\d.]+)'],
      depNameTemplate: 'gohugoio/hugo',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\\/ci-tool-versions\\.env$/'],
      matchStrings: ['K6_IMAGE=(?<packageName>grafana/k6):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})'],
      autoReplaceStringTemplate: 'K6_IMAGE=grafana/k6:{{{newValue}}}@{{{newDigest}}}',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\\/ci-tool-versions\\.env$/'],
      matchStrings: ['GOVULNCHECK_VERSION=(?<currentValue>v[\\d.]+)'],
      depNameTemplate: 'golang.org/x/vuln/cmd/govulncheck',
      packageNameTemplate: 'golang.org/x/vuln',
      datasourceTemplate: 'go',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\\/ci-tool-versions\\.env$/'],
      matchStrings: ['GORELEASER_VERSION=(?<currentValue>v[\\d.]+)'],
      depNameTemplate: 'goreleaser/goreleaser',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      // TruffleHog runs directly from Docker in secret-scan.yml. Keep its tag
      // and OCI index digest in one managed value so security scanning remains
      // immutable while Renovate updates both together.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\\/ci-tool-versions\\.env$/'],
      matchStrings: ['TRUFFLEHOG_IMAGE=(?<packageName>ghcr\\.io/trufflesecurity/trufflehog):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})'],
      autoReplaceStringTemplate: 'TRUFFLEHOG_IMAGE=ghcr.io/trufflesecurity/trufflehog:{{{newValue}}}@{{{newDigest}}}',
      depNameTemplate: 'trufflesecurity/trufflehog',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      // Commit-only repositories follow the selected branch digest. The update
      // command resolves go-libghostty's digest to its Go pseudo-version.
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"goLibghostty":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"renovateRef":\\s*"(?<currentValue>[^"]+)",\\s*"commit":\\s*"(?<currentDigest>[0-9a-f]{40})"',
      ],
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'go-libghostty',
      depTypeTemplate: 'libghostty-native',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"ghostty":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"renovateRef":\\s*"(?<currentValue>[^"]+)",\\s*"commit":\\s*"(?<currentDigest>[0-9a-f]{40})"',
      ],
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'Ghostty',
      depTypeTemplate: 'libghostty-native',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"zig":\\s*\\{\\s*"repository":\\s*"https://codeberg\\.org/(?<packageName>[^"]+)",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'forgejo-tags',
      depNameTemplate: 'Zig',
      depTypeTemplate: 'libghostty-native',
      registryUrlTemplate: 'https://codeberg.org',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"uucode":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'uucode',
      depTypeTemplate: 'libghostty-native',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"highway":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'Highway',
      depTypeTemplate: 'libghostty-native',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"simdutf":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'simdutf',
      depTypeTemplate: 'libghostty-native',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^libghostty-native\\.lock\\.json$/'],
      matchStrings: [
        '"spdxTools":\\s*\\{\\s*"repository":\\s*"(?<packageName>[^"]+)",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'SPDX tools-java',
      depTypeTemplate: 'libghostty-native',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: [
        'GOLANGCI_LINT_VERSION := (?<currentValue>v[\\d\\.]+)\\s+GOLANGCI_LINT_DIGEST := (?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      autoReplaceStringTemplate: 'GOLANGCI_LINT_VERSION := {{{newValue}}}\nGOLANGCI_LINT_DIGEST := {{{newDigest}}}',
      depNameTemplate: 'golangci/golangci-lint',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      // Keep the nono version CI tests against on the latest release. The
      // sandbox workflow verifies the download by build-provenance attestation
      // (version-independent), so only this version string needs bumping.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/sandbox\\.yml$/'],
      matchStrings: ['NONO_VERSION:\\s*"(?<currentValue>[\\d.]+)"'],
      depNameTemplate: 'nolabs-ai/nono',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      // Keep the Safehouse version CI tests against visible in the dependency
      // workflow. The sandbox workflow verifies the release asset against the
      // reviewed SHA-256 before installing, so maintainers must update
      // SAFEHOUSE_SHA256 after inspecting a version bump.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/sandbox\\.yml$/'],
      matchStrings: ['SAFEHOUSE_VERSION:\\s*"(?<currentValue>[\\d.]+)"'],
      depNameTemplate: 'eugene1g/agent-safehouse',
      depTypeTemplate: 'ci-safehouse',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      // Keep actionlint on the latest release. The workflow-lint workflow
      // verifies the download by build-provenance attestation
      // (version-independent), so only this version string needs bumping.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/workflow-lint\\.yml$/'],
      matchStrings: ['ACTIONLINT_VERSION:\\s*(?<currentValue>[\\d.]+)'],
      depNameTemplate: 'rhysd/actionlint',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      // Keep zizmor on the latest release. Same provenance-verified,
      // version-independent install as actionlint/nono — only the version
      // string bumps; the attestation check needs no per-version update.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/workflow-lint\\.yml$/'],
      matchStrings: ['ZIZMOR_VERSION:\\s*(?<currentValue>[\\d.]+)'],
      depNameTemplate: 'zizmorcore/zizmor',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
  ],
}
