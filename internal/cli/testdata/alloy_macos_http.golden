// Generated by `gr config alloy` from resolved Graith config.
// Set referenced sys.env(...) values in Alloy's service environment.
// Daemon logs are included; session scrollback logs are intentionally omitted.

loki.source.file "graith_daemon" {
  targets = [
    {
      "__path__"  = "/Users/bairn/Library/Application Support/graith/daemon.log",
      "job"       = "graith",
      "component" = "daemon",
    },
    {
      "__path__"  = "/Users/bairn/Library/Application Support/graith/daemon.stderr.log",
      "job"       = "graith",
      "component" = "daemon-stderr",
    },
  ]
  forward_to = [loki.write.graith.receiver]

  file_match {
    enabled = true
  }
}

loki.write "graith" {
  endpoint {
    url = sys.env("GRAITH_LOKI_URL")

    basic_auth {
      username = sys.env("GRAITH_LOKI_USERNAME")
      password = sys.env("GRAITH_LOKI_TOKEN")
    }
  }
}

prometheus.scrape "graith" {
  job_name = "graith"

  targets = [{
    "__address__" = "127.0.0.1:9824",
  }]

  metrics_path = "/graith/metrics"
  forward_to   = [prometheus.remote_write.graith.receiver]
}

prometheus.remote_write "graith" {
  endpoint {
    url = sys.env("GRAITH_MIMIR_URL")

    basic_auth {
      username = sys.env("GRAITH_MIMIR_USERNAME")
      password = sys.env("GRAITH_MIMIR_TOKEN")
    }
  }
}

otelcol.receiver.otlp "graith" {
  http {
    endpoint        = "127.0.0.1:4318"
    traces_url_path = "/otlp/v1/traces"
  }

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("GRAITH_TEMPO_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

otelcol.auth.basic "tempo" {
  client_auth {
    username = sys.env("GRAITH_TEMPO_USERNAME")
    password = sys.env("GRAITH_TEMPO_TOKEN")
  }
}
