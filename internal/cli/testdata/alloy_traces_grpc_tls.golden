// Generated by `gr config alloy` from resolved Graith config.
// Set referenced sys.env(...) values in Alloy's service environment.

otelcol.receiver.otlp "graith" {
  grpc {
    endpoint = "127.0.0.1:4317"

    tls {
      cert_file = sys.env("GRAITH_OTLP_RECEIVER_TLS_CERT_FILE")
      key_file  = sys.env("GRAITH_OTLP_RECEIVER_TLS_KEY_FILE")
    }
  }

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("GRAITH_TEMPO_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

otelcol.auth.basic "tempo" {
  client_auth {
    username = sys.env("GRAITH_TEMPO_USERNAME")
    password = sys.env("GRAITH_TEMPO_TOKEN")
  }
}
