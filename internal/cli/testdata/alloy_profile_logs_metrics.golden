// Generated by `gr config alloy` from resolved Graith config.
// Set referenced sys.env(...) values in Alloy's service environment.
// Daemon logs are included; session scrollback logs are intentionally omitted.

loki.source.file "graith_daemon" {
  targets = [
    {
      "__path__"  = "/home/bairn/.local/share/graith-canny/daemon.log",
      "job"       = "graith",
      "component" = "daemon",
    },
    {
      "__path__"  = "/home/bairn/.local/share/graith-canny/daemon.stderr.log",
      "job"       = "graith",
      "component" = "daemon-stderr",
    },
  ]
  forward_to = [loki.write.graith.receiver]

  file_match {
    enabled = true
  }
}

loki.write "graith" {
  endpoint {
    url = sys.env("GRAITH_LOKI_URL")

    basic_auth {
      username = sys.env("GRAITH_LOKI_USERNAME")
      password = sys.env("GRAITH_LOKI_TOKEN")
    }
  }
}

prometheus.scrape "graith" {
  job_name = "graith"

  targets = [{
    "__address__" = "[::1]:4824",
  }]

  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.graith.receiver]
}

prometheus.remote_write "graith" {
  endpoint {
    url = sys.env("GRAITH_MIMIR_URL")

    basic_auth {
      username = sys.env("GRAITH_MIMIR_USERNAME")
      password = sys.env("GRAITH_MIMIR_TOKEN")
    }
  }
}
